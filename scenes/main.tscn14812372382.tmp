[sub_resource type="GDScript" id="GDScript_0wfyh"]
script/source = "extends Node2D

## Places hand-authored chunk scenes on an infinite 2D grid around the player.

const STARTER_SCENE := preload(\"res://scenes/chunks/chunk_starter.tscn\")
const ISLANDS_SCENE := preload(\"res://scenes/chunks/chunk_islands.tscn\")
const LADDER_SCENE := preload(\"res://scenes/chunks/chunk_ladder.tscn\")
const BRIDGE_SCENE := preload(\"res://scenes/chunks/chunk_bridge.tscn\")

@export var player: Node2D
@export var world_seed: int = 42
@export var chunk_size: float = 320.0
@export var load_radius: int = 1
@export var starter_chunk: PackedScene
@export var chunk_pool: Array[ChunkEntry] = []

var _loaded: Dictionary = {} # Vector2i -> Node2D
var _last_coord: Vector2i = Vector2i(0x7FFFFFFF, 0x7FFFFFFF)


func _ready() -> void:
	if player == null:
		player = get_parent().get_node_or_null(\"Player\")
	if starter_chunk == null:
		starter_chunk = STARTER_SCENE
	if chunk_pool.is_empty():
		chunk_pool = _default_pool()
	_update_chunks(true)


func _process(_delta: float) -> void:
	_update_chunks(false)


func _default_pool() -> Array[ChunkEntry]:
	return [
		_make_entry(ISLANDS_SCENE, [\"open\", \"combat\"], 1.0),
		_make_entry(LADDER_SCENE, [\"vertical\", \"ascent\"], 1.0),
		_make_entry(BRIDGE_SCENE, [\"horizontal\", \"path\"], 1.0),
	]


func _make_entry(scene: PackedScene, tags: Array, weight: float) -> ChunkEntry:
	var entry := ChunkEntry.new()
	entry.scene = scene
	entry.tags = PackedStringArray(tags)
	entry.weight = weight
	return entry


func _update_chunks(force: bool) -> void:
	if player == null:
		return

	var coord := world_to_chunk(player.global_position)
	if not force and coord == _last_coord:
		return
	_last_coord = coord

	var needed: Dictionary = {}
	for y in range(coord.y - load_radius, coord.y + load_radius + 1):
		for x in range(coord.x - load_radius, coord.x + load_radius + 1):
			var key := Vector2i(x, y)
			needed[key] = true
			if not _loaded.has(key):
				_load_chunk(key)

	var to_unload: Array[Vector2i] = []
	for existing: Vector2i in _loaded.keys():
		if not needed.has(existing):
			to_unload.append(existing)

	for key in to_unload:
		_unload_chunk(key)


func world_to_chunk(world_pos: Vector2) -> Vector2i:
	return Vector2i(
		floori(world_pos.x / chunk_size),
		floori(world_pos.y / chunk_size)
	)


func chunk_to_world(coord: Vector2i) -> Vector2:
	return Vector2(coord) * chunk_size


func _load_chunk(coord: Vector2i) -> void:
	var scene := _pick_chunk_scene(coord)
	if scene == null:
		push_warning(\"ChunkManager: no chunk scene for %s\" % coord)
		return

	var chunk: Node2D = scene.instantiate()
	chunk.position = chunk_to_world(coord)
	add_child(chunk)
	_loaded[coord] = chunk


func _unload_chunk(coord: Vector2i) -> void:
	var chunk: Node = _loaded[coord]
	_loaded.erase(coord)
	chunk.queue_free()


## Placement rules live here. Same seed + coord always picks the same chunk.
func _pick_chunk_scene(coord: Vector2i) -> PackedScene:
	if coord == Vector2i.ZERO:
		return starter_chunk

	var rng := RandomNumberGenerator.new()
	rng.seed = hash(Vector3i(world_seed, coord.x, coord.y))

	var candidates: Array[ChunkEntry] = chunk_pool.duplicate()

	# Example rule: above origin, prefer vertical / ascent layouts.
	if coord.y < 0:
		var vertical := _entries_with_tag(candidates, \"vertical\")
		if not vertical.is_empty() and rng.randf() < 0.65:
			candidates = vertical

	# Example rule: farther out, avoid \"safe\" tagged chunks.
	var dist := absi(coord.x) + absi(coord.y)
	if dist >= 2:
		var non_safe: Array[ChunkEntry] = []
		for entry in candidates:
			if entry != null and not entry.tags.has(\"safe\"):
				non_safe.append(entry)
		if not non_safe.is_empty():
			candidates = non_safe

	return _weighted_pick(candidates, rng)


func _entries_with_tag(entries: Array[ChunkEntry], tag: String) -> Array[ChunkEntry]:
	var result: Array[ChunkEntry] = []
	for entry in entries:
		if entry == null or entry.scene == null:
			continue
		if entry.tags.has(tag):
			result.append(entry)
	return result


func _weighted_pick(entries: Array[ChunkEntry], rng: RandomNumberGenerator) -> PackedScene:
	var valid: Array[ChunkEntry] = []
	var total := 0.0
	for entry in entries:
		if entry == null or entry.scene == null:
			continue
		valid.append(entry)
		total += maxf(entry.weight, 0.0)

	if valid.is_empty():
		return starter_chunk
	if total <= 0.0:
		return valid[rng.randi() % valid.size()].scene

	var roll := rng.randf() * total
	var acc := 0.0
	for entry in valid:
		acc += maxf(entry.weight, 0.0)
		if roll <= acc:
			return entry.scene
	return valid.back().scene
"

